if SHIELD_REDOX_DONGLE

config ZMK_KEYBOARD_NAME
    default "Redox"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT
    default y

# Redox has two peripherals: left and right halves
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# = peripherals (2) + default 5 BT profiles
config BT_MAX_CONN
    default 5

config BT_MAX_PAIRED
    default 5

endif